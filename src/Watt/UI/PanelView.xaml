<UserControl x:Class="Watt.UI.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Watt.UI"
             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale">
    <Grid x:Name="Outer" Margin="22">
        <Border x:Name="Card"
                Width="288"
                CornerRadius="12"
                BorderThickness="1"
                Background="#FFFFFFFF"
                BorderBrush="#FFE7E7EA"
                UseLayoutRounding="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="1" Direction="270"
                                  Opacity="0.10" Color="#FF000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Quiet header: edit names on the left, transient refresh feedback and refresh on the right. -->
                <Grid Grid.Row="0" Height="34" Margin="0,8,12,0">
                    <Button x:Name="EditButton"
                            Width="26"
                            Height="26"
                            Padding="0"
                            Margin="18,0,0,0"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Focusable="False"
                            Cursor="Hand"
                            ToolTip="修改设备名"
                            Click="EditButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome"
                                        CornerRadius="13"
                                        Background="Transparent">
                                    <TextBlock Text="{x:Static local:Glyphs.Edit}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background"
                                                Value="{DynamicResource RefreshHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Chrome" Property="Background"
                                                Value="{DynamicResource RefreshPressedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="RefreshFeedback"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed" />
                        <Button x:Name="RefreshButton"
                                Width="26"
                                Height="26"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Focusable="False"
                                Cursor="Hand"
                                ToolTip="刷新"
                                Click="RefreshButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome"
                                            CornerRadius="13"
                                            Background="Transparent">
                                        <TextBlock Text="{x:Static local:Glyphs.Refresh}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource RefreshHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource RefreshPressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ItemsControl x:Name="DeviceList" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="20"
                                               Foreground="{Binding GlyphBrush}"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Margin="14,0,8,0"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{Binding NameBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding NameVisibility}"
                                               TextOptions.TextRenderingMode="Grayscale" />

                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="12,0,6,0"
                                             Height="26"
                                             VerticalAlignment="Center"
                                             FontSize="13"
                                             FontWeight="Medium"
                                             Foreground="{Binding NameBrush}"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             Padding="2,1,2,2"
                                             MaxLength="40"
                                             VerticalContentAlignment="Center"
                                             Visibility="{Binding EditVisibility}"
                                             KeyDown="NameBox_KeyDown"
                                             LostFocus="NameBox_LostFocus" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE945;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="11"
                                                   Foreground="{Binding PercentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"
                                                   Visibility="{Binding ChargingVisibility}" />
                                        <TextBlock Text="{Binding PercentText}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{Binding PercentBrush}"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Focusable="False"
                                            Cursor="Hand"
                                            ToolTip="删除设备"
                                            Tag="{Binding}"
                                            Click="DeleteButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chrome"
                                                        CornerRadius="11"
                                                        Background="Transparent">
                                                    <TextBlock Text="{x:Static local:Glyphs.Close}"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding PercentBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background"
                                                                Value="{DynamicResource RefreshHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background"
                                                                Value="{DynamicResource RefreshPressedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state: a single line, no icon, no hint copy. -->
                    <TextBlock x:Name="EmptyText"
                               Text="未连接外设"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,24"
                               Visibility="Collapsed" />

                    <!-- Loading state: three quiet skeleton rows, no spinner, no label. -->
                    <StackPanel x:Name="LoadingHost" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid Height="46">
                            <TextBlock Text="&#xE92E;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                       Foreground="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                            <Border Width="110" Height="9" CornerRadius="4.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="52,0,0,0"
                                    Background="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}" />
                            <Border Width="30" Height="9" CornerRadius="4.5" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,18,0"
                                    Background="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}" />
                        </Grid>
                        <Grid Height="46">
                            <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                       Foreground="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                            <Border Width="82" Height="9" CornerRadius="4.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="52,0,0,0"
                                    Background="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}" />
                            <Border Width="30" Height="9" CornerRadius="4.5" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,18,0"
                                    Background="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}" />
                        </Grid>
                        <Grid Height="46">
                            <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                       Foreground="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                            <Border Width="96" Height="9" CornerRadius="4.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="52,0,0,0"
                                    Background="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}" />
                            <Border Width="30" Height="9" CornerRadius="4.5" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,18,0"
                                    Background="{Binding SkeletonBrush, RelativeSource={RelativeSource AncestorType=local:PanelView}}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
