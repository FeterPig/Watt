<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Allows Assembly.LoadFrom to load plugins from folders that Windows marks as
         "remote" (some redirected/workspace paths). Normal per-user installs do not need
         this, but it keeps development/staged builds working. PluginHost also falls back
         to Assembly.Load(byte[]) when LoadFrom is refused. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
